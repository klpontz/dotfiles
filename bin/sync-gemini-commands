#!/usr/bin/env python3
"""Make Claude commands and skills available in Gemini CLI.

Claude stays the source. Run this again after you edit a Claude command.

- Commands: each ~/.claude/commands/<name>.md becomes ~/.gemini/commands/<name>.toml.
  The Markdown body becomes the prompt. $ARGUMENTS becomes {{args}}.
- Skills: each ~/.claude/skills/<name>/SKILL.md is linked into Gemini.
  A link reads the source directly, so skill edits need no resync.

Usage: sync-gemini-commands [--dry-run]
"""
import re
import subprocess
import sys
from pathlib import Path

CLAUDE_COMMANDS = Path.home() / ".claude/commands"
CLAUDE_SKILLS = Path.home() / ".claude/skills"
GEMINI_COMMANDS = Path.home() / ".gemini/commands"

# Commands that need a Gemini rewrite before they can sync.
SKIP_COMMANDS = {"pull-daily"}
# council runs Gemini as one of its advisors. In Gemini, it would call itself.
SKIP_SKILLS = {"council"}

MARKER = "# Generated by sync-gemini-commands from {src}. Do not edit. Edit the source and rerun.\n"


def split_frontmatter(text):
    """Return (frontmatter dict, body). Only reads simple `key: value` lines."""
    match = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.S)
    if not match:
        return {}, text
    meta = {}
    for line in match.group(1).splitlines():
        key, sep, value = line.partition(":")
        if sep:
            meta[key.strip()] = value.strip()
    return meta, match.group(2)


def toml_string(value):
    """Basic TOML string, escaped for one line."""
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def to_toml(src, meta, body):
    prompt = body.strip("\n").replace("$ARGUMENTS", "{{args}}")
    if "'''" in prompt:
        raise ValueError(f"{src} contains ''' and cannot be a TOML literal string")
    out = MARKER.format(src=src)
    if meta.get("description"):
        out += f"description = {toml_string(meta['description'])}\n"
    # Literal string: backslashes and quotes stay exactly as written.
    out += f"prompt = '''\n{prompt}\n'''\n"
    return out


def sync_commands(dry_run):
    GEMINI_COMMANDS.mkdir(parents=True, exist_ok=True)
    for src in sorted(CLAUDE_COMMANDS.glob("*.md")):
        if src.stem in SKIP_COMMANDS:
            print(f"skip command  {src.stem}")
            continue
        meta, body = split_frontmatter(src.read_text())
        dest = GEMINI_COMMANDS / f"{src.stem}.toml"
        if dest.exists() and not dest.read_text().startswith("# Generated by sync-gemini-commands"):
            print(f"keep command  {src.stem} (hand-written {dest.name} exists)")
            continue
        if not dry_run:
            dest.write_text(to_toml(src, meta, body))
        print(f"sync command  /{src.stem} -> {dest}")


def linked_skills():
    out = subprocess.run(["gemini", "skills", "list", "--all"], capture_output=True, text=True).stdout
    return set(re.findall(r"^(\S+) \[", out, re.M))


def sync_skills(dry_run):
    present = linked_skills()
    for skill in sorted(CLAUDE_SKILLS.glob("*/SKILL.md")):
        name = skill.parent.name
        if name in SKIP_SKILLS:
            print(f"skip skill    {name}")
            continue
        if name in present:
            print(f"have skill    {name}")
            continue
        if not dry_run:
            subprocess.run(["gemini", "skills", "link", str(skill.parent), "--consent"],
                           check=True, capture_output=True)
        print(f"link skill    {name}")


if __name__ == "__main__":
    dry = "--dry-run" in sys.argv
    sync_commands(dry)
    sync_skills(dry)
